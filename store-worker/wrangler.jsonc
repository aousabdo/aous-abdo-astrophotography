{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "one-more-photon-store",
  "main": "src/index.js",
  "compatibility_date": "2026-07-21",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.onemorephoton.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "SITE_ORIGIN": "https://onemorephoton.com",
    "SITE_ORIGIN_WWW": "https://www.onemorephoton.com",
    "STRIPE_API_VERSION": "2025-03-31.basil",
    "DOWNLOAD_TTL_SECONDS": "86400",
    "DOWNLOAD_MAX_COUNT": "3"
  },
  "r2_buckets": [
    {
      "binding": "DOWNLOADS_BUCKET",
      "bucket_name": "one-more-photon-private-downloads"
    }
  ],
  "d1_databases": [
    {
      "binding": "ORDERS_DB",
      "database_name": "one-more-photon-orders",
      "database_id": "f58d8fc5-93fc-4e5f-8c10-a0adef69a9a9",
      "migrations_dir": "migrations"
    }
  ]
}
